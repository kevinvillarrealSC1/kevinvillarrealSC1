//kQL for Sign-ins to PowerShell Modules
SigninLogs
| where TimeGenerated >= ago(90d)
| where AppId == "1950a258-227b-4e31-a9cf-717495945fc2" // Microsoft Azure PowerShel
    or AppId == "1b730954-1685-4b74-9bfd-dac224a7b894" // Azure Active Directory PowerShell
    or AppId == "fb78d390-0c51-40cd-8e17-fdbfab77341b" // Microsoft Exchange REST API PowerShell
    or AppId == "9bc3ab49-b65d-410a-85ad-de819febfddc" // Microsoft SharePoint Online Management Shell
    or AppId == "12128f48-ec9e-42f0-b203-ea49fb6af367" // MS Teams Powershell Cmdlets
    or AppId == "a0c73c16-a7e3-4564-9a95-2bdf47383716" // Microsoft Exchange Online Remote PowerShell
| summarize count() by UserPrincipalName, UserDisplayName, AppDisplayName, IPAddress, ResultType, ResultDescription
