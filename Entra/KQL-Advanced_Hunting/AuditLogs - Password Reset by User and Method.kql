//Password Reset by User and Method
AuditLogs
| where TimeGenerated >= ago(90d)
| where OperationName == "Reset password (self-service)"
| extend ParsedDetails = parse_json(AdditionalDetails)
| mv-expand ParsedDetails
| where ParsedDetails.key == "MethodsUsedForValidation"
| extend MethodsUsed = tostring(ParsedDetails.value)
